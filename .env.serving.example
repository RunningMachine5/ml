# 실제 MLflow Registry 모델을 로컬 Serving으로 실행하는 예시입니다.
# 단순 Backend 연동 테스트는 이 파일 없이 ML_PREDICTOR_MODE=stub으로 실행할 수 있습니다.

# --- Predictor -------------------------------------------------------------
# stub: 실제 모델 없이 계약 확인, mlflow: 아래 정확한 Registry 버전 로드
ML_PREDICTOR_MODE=mlflow
ML_MODEL_NAME=fdshield-fraud-detector
ML_MODEL_VERSION=1
# --- MLflow 연결 -----------------------------------------------------------
MLFLOW_TRACKING_URI=https://mlflow.fdshield.cloud
# Serving 전용 계정을 사용하고 실제 값이 든 .env.serving은 Git에 커밋하지 마세요.
MLFLOW_TRACKING_USERNAME=your-serving-username
MLFLOW_TRACKING_PASSWORD=your-serving-password
