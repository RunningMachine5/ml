# 학습·비교 스크립트가 팀 공용 MLflow에 Run을 기록할 때 사용하는 예시입니다.
# 이 파일을 .env.tracking으로 복사한 뒤 각자 발급받은 계정을 넣으세요.

# 팀 공용 MLflow Tracking Server 주소입니다.
MLFLOW_TRACKING_URI=https://mlflow.fdshield.cloud

# 관리자 계정을 공유하지 말고 팀원별 계정을 사용하세요.
# 실제 사용자명·비밀번호가 들어간 .env.tracking은 Git에 커밋하지 마세요.
MLFLOW_TRACKING_USERNAME=your-username
MLFLOW_TRACKING_PASSWORD=your-password

# 서로 다른 모델도 같은 실험 화면에서 비교하도록 팀 공통 Experiment를 사용합니다.
MLFLOW_EXPERIMENT_NAME=fdshield-model-comparison
