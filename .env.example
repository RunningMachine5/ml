# 로컬 MLflow Tracking Server를 직접 띄울 때 사용하는 예시입니다.
# 실제 비밀번호·비밀키는 Git에 커밋하지 마세요.

# --- MLflow 메타데이터 DB -------------------------------------------------
# 기존 Backend Compose의 로컬 ParadeDB와 동일한 계정을 사용합니다.
POSTGRES_USER=root
POSTGRES_PASSWORD=1234
POSTGRES_DB=fdshield-db

# MLflow 메타데이터와 인증 정보가 저장될 논리 데이터베이스입니다.
MLFLOW_DB=mlflow

# MLflow UI 최초 관리자 계정입니다. 첫 실행 전에 반드시 변경하세요.
MLFLOW_ADMIN_USERNAME=admin
MLFLOW_ADMIN_PASSWORD=change-this-admin-password

# CSRF 보호용 비밀키입니다. 길고 임의적인 문자열로 변경하세요.
MLFLOW_FLASK_SERVER_SECRET_KEY=change-this-to-a-long-random-secret

# --- 로컬 Stub Serving -----------------------------------------------------
# 실제 모델 없이 Backend↔ML 계약만 확인하는 규칙 기반 Stub 응답값입니다.
ML_FRAUD_THRESHOLD=0.55
ML_MODEL_NAME=fdshield-rule-based-stub
ML_MODEL_VERSION=0
