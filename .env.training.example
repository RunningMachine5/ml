# 로컬에서 Training Job을 직접 실행할 때 사용하는 예시입니다.
# 실제 계정·Callback Token이 든 .env.training은 Git에 커밋하지 마세요.

# --- 학습 데이터 ----------------------------------------------------------
# 학습 입력은 ML 담당자가 전달한 train1 raw64 CSV 한 종류만 지원합니다.
# Cloud Run Job에서는 같은 파일을 비공개 GCS에 올린 gs:// URI로 교체합니다.
TRAINING_DATA_URI=data/open/train1.csv
MLFLOW_EXPERIMENT_NAME=fdshield-binary-training

# --- 모델 비교·승격 정책 --------------------------------------------------
MLFLOW_REGISTERED_MODEL_NAME=fdshield-fraud-detector-v2
MLFLOW_MODEL_ALIAS=champion
# 후보의 최소 유효성 기준이며 운영 모델과의 상대 비교는 별도로 수행됩니다.
MODEL_MIN_PR_AUC=0.0
MODEL_MIN_RECALL=0.0

# --- Backend 결과 Callback ------------------------------------------------
# 로컬 단독 실행에서는 아래 값을 비워둘 수 있습니다.
# Backend가 실행 ID를 override하면 결과를 이 주소로 되돌려 보냅니다.
# 성공 시 status와 mlflow_run_id, 실패 시 status와 오류 요약만 전송합니다.
# 모델 버전·지표·비교 결과·추천은 MLflow Run/Registry에서 조회합니다.
# CLOUD_RUN_EXECUTION은 Cloud Run이 자동 주입하며 로컬에서는 설정하지 않습니다.
# 토큰은 Git에 넣지 않고 Cloud Run Secret Manager로 주입합니다.
BACKEND_TRAINING_RUN_ID=
TRAINING_RESULT_CALLBACK_URL=https://api.fdshield.cloud/mlops/training/runs/{training_run_id}/result
TRAINING_RESULT_CALLBACK_TOKEN=

# --- MLflow 인증 -----------------------------------------------------------
# 로컬에서는 각자 계정, Cloud Run에서는 Secret Manager로 주입합니다.
MLFLOW_TRACKING_URI=https://mlflow.fdshield.cloud
MLFLOW_TRACKING_USERNAME=your-training-job-username
MLFLOW_TRACKING_PASSWORD=your-training-job-password
