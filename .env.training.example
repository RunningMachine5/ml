# 기본 운영 학습은 생성형 원본 transactions.csv 하나를 ML 내부에서 전처리합니다.
# 전처리된 train.csv를 직접 쓸 때만 행 순서가 같은 transactions.csv를 함께 지정합니다.
TRAINING_JOB_TYPE=binary
TRAINING_DATA_URI=data/open/generated/transactions.csv
# TRAINING_TRANSACTIONS_URI=data/open/generated/transactions.csv
TRAINING_SPLIT_DATETIME=2026-04-01 00:00:00
MLFLOW_EXPERIMENT_NAME=fdshield-binary-training
TRAINING_MODE=train
MLFLOW_REGISTERED_MODEL_NAME=fdshield-fraud-detector
MLFLOW_MODEL_ALIAS=champion
MLFLOW_AUTO_PROMOTE=true
MODEL_MIN_PR_AUC=0.0
MODEL_MIN_RECALL=0.0

# Cloud Run에서는 계정 정보를 Secret Manager로 주입합니다.
MLFLOW_TRACKING_URI=https://mlflow.fdshield.cloud
MLFLOW_TRACKING_USERNAME=your-training-job-username
MLFLOW_TRACKING_PASSWORD=your-training-job-password
